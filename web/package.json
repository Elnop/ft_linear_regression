{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.test.json",
    "lint": "oxlint --type-aware src test e2e oxlint.config.ts",
    "deps": "depcruise '{src,test}/**/*.{ts,tsx}' --output-type err-long --ignore-known",
    "tree": "check-tree src",
    "check": "npm run typecheck && npm run lint && npm run deps && npm run tree && npm run exceptions",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "vite build && playwright test",
    "exceptions": "check-exceptions"
  },
  "dependencies": {
    "motion": "14.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@brutalway/check-exceptions": "0.2.1",
    "@brutalway/check-tree": "0.15.0",
    "@brutalway/dependency-cruiser-config": "0.14.0",
    "@brutalway/oxlint-config-react-vite": "0.6.1",
    "@brutalway/playwright-fixtures": "0.2.0",
    "@brutalway/tsconfig": "0.4.0",
    "@playwright/test": "1.65.0",
    "@swc/core": "1.16.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  },
  "check-exceptions": {
    "newRules": {
      "check-tree kind-folder": 2,
      "check-tree not-a-kind-folder": 1,
      "check-tree not-a-layer": 2,
      "check-tree shared-feature-groups": 34,
      "check-tree shared-root-files": 8,
      "check-tree single-consumer": 18,
      "check-tree test-in-source": 32,
      "dependency-cruiser no-cross-shared": 23,
      "dependency-cruiser no-cross-sub-shared": 42,
      "dependency-cruiser not-to-dev-dep": 36,
      "dependency-cruiser presenters-are-pure": 3,
      "dependency-cruiser stores-in-their-folder": 11,
      "oxlint-suppressions component-roles/no-restricted-syntax": 26,
      "oxlint-suppressions function-size/max-functions": 3,
      "oxlint-suppressions function-size/max-variables": 44,
      "oxlint-suppressions max-lines-per-function": 57,
      "oxlint-suppressions max-nested-callbacks": 2,
      "oxlint-suppressions max-params": 9,
      "oxlint-suppressions react/no-array-index-key": 5,
      "oxlint-suppressions sonarjs/cognitive-complexity": 2,
      "dependency-cruiser unit-test-own-source": 12,
      "oxlint-suppressions typescript/no-redundant-type-constituents": 1
    }
  }
}
