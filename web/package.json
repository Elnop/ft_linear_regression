{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p . && tsc -p tests",
    "lint": "oxlint --type-aware src tests",
    "deps": "depcruise src",
    "folders": "node scripts/checkFolders.mjs",
    "check": "npm run typecheck && npm run lint && npm run deps && npm run folders",
    "test": "node --import ./tests/aliases.ts --test 'tests/**/*.test.ts'",
    "e2e": "vite build && node --test tests/browser.e2e.ts"
  },
  "dependencies": {
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.7.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.5"
  }
}
