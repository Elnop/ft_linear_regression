{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.test.json",
    "lint": "oxlint --type-aware src e2e oxlint.config.ts",
    "deps": "depcruise src",
    "tree": "check-tree src",
    "check": "npm run typecheck && npm run lint && npm run deps && npm run tree",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "vite build && playwright test"
  },
  "dependencies": {
    "motion": "14.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@brutalway/check-tree": "0.4.0",
    "@brutalway/dependency-cruiser-config": "0.4.0",
    "@brutalway/oxlint-config-react-vite": "0.4.1",
    "@brutalway/playwright-fixtures": "0.1.0",
    "@brutalway/tsconfig": "0.2.0",
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.21",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  }
}
