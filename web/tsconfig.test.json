{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["vite/client", "node", "@vitest/browser-playwright"],
    "paths": {
      "@/*": ["./src/*"],
      "@core/*": ["../core/*"],
      "@dataset": ["../data.csv"],
      "@test-e2e/*": ["./test/e2e/*"],
      "@test-support/*": ["./test/support/*"]
    }
  },
  "include": [
    "src",
    "test",
    "../core",
    "vite.config.ts",
    "vitest.config.ts",
    "oxlint.config.ts",
    "playwright.config.ts"
  ],
  "exclude": []
}
