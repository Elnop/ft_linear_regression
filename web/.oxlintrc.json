{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../checks/exportConventions.json"],
  "plugins": ["typescript", "react", "import", "oxc", "unicorn"],
  "jsPlugins": [
    "../checks/conventions/plugin.ts",
    {
      "name": "no-comments",
      "specifier": "eslint-plugin-no-comments"
    },
    {
      "name": "check-file",
      "specifier": "eslint-plugin-check-file"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["dist"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^\\.\\.?/",
            "message": "Relative imports are not allowed: import through an alias (@/, @core/, @e2e/)."
          }
        ]
      }
    ],
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-duplicates": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "react/only-export-components": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "off",
    "import/default": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "no-shadow": "off",
    "no-unused-expressions": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/prefer-add-event-listener": "off",
    "typescript/consistent-return": "off",
    "oxc/no-barrel-file": [
      "error",
      {
        "threshold": 0
      }
    ],
    "unicorn/filename-case": [
      "error",
      {
        "cases": {
          "camelCase": true,
          "pascalCase": true
        }
      }
    ],
    "no-comments/disallowComments": [
      "error",
      {
        "allow": ["oxlint-", "eslint-", "@ts-expect-error", "@ts-ignore", "@ts-nocheck", "/ <reference "]
      }
    ],
    "check-file/no-index": [
      "error",
      {
        "errorMessage": "Barrel files ({{ target }}) are not allowed: import each module by its own path"
      }
    ],
    "check-file/filename-blocklist": [
      "error",
      {
        "**/types.ts": "*Types.ts"
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "conventions/file-named-after-export": "error",
        "conventions/store-layout": "error"
      }
    },
    {
      "files": ["src/**/*.test.ts", "src/**/*.test.tsx"],
      "rules": {
        "typescript/no-floating-promises": "off",
        "conventions/file-named-after-export": "off"
      }
    },
    {
      "files": ["e2e/**"],
      "env": {
        "node": true
      }
    }
  ]
}
