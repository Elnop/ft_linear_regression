{
  "name": "ft_linear_regression",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=26"
  },
  "prettier": "@elnop/prettier-config",
  "scripts": {
    "train": "node cli/train.ts",
    "predict": "node cli/predict.ts",
    "precision": "node cli/precision.ts",
    "web": "npm run dev -w web",
    "build": "npm run build -w web",
    "e2e": "npm run e2e -w web",
    "typecheck": "tsc -p . && npm run typecheck -w web",
    "lint": "oxlint --type-aware core cli oxlint.config.ts",
    "test": "npm test -w web",
    "format": "prettier --write .",
    "check": "prettier --check . && npm run lint && tsc -p . && alint check && knip && npm run check -w web",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@asamarts/alint": "0.21.0",
    "@elnop/agent-hook": "0.1.0",
    "@elnop/alint-config": "0.1.0",
    "@elnop/oxlint-config-typescript": "0.4.0",
    "@elnop/prettier-config": "0.1.0",
    "@elnop/tsconfig": "0.2.0",
    "@types/node": "26.6.6",
    "knip": "6.42.1",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "@swc/core": false,
    "@asamarts/alint@0.21.0": true
  },
  "overrides": {
    "eslint-plugin-no-comments": {
      "minimatch": "^11.0.1"
    }
  }
}
