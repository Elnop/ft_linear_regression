{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no-install elnop-agent-hook --tree web/src",
            "timeout": 60,
            "statusMessage": "checks on the edited file"
          }
        ]
      }
    ]
  }
}
